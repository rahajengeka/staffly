<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%" fill="none">
  <defs>
    <linearGradient id="bizGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0e382f" />
      <stop offset="100%" stop-color="#082821" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background Card -->
  <rect width="600" height="450" rx="28" fill="url(#bizGrad)" />
  <rect x="1" y="1" width="598" height="448" rx="27" stroke="#7be147" stroke-opacity="0.3" stroke-width="1.5" />

  <!-- Circular Radar / Graphic accents from Biztop -->
  <circle cx="500" cy="100" r="140" stroke="#7be147" stroke-width="1.5" stroke-opacity="0.2" fill="none" stroke-dasharray="6 6" />
  <circle cx="500" cy="100" r="80" stroke="#7be147" stroke-width="2" stroke-opacity="0.35" fill="none" />
  <circle cx="500" cy="100" r="16" fill="#7be147" />

  <!-- Professional Team Silhouette & Collaborative Interface -->
  <!-- Left floating metric pill -->
  <g transform="translate(40, 60)" filter="url(#shadow)">
    <rect width="180" height="60" rx="30" fill="#ffffff" />
    <circle cx="30" cy="30" r="20" fill="#7be147" />
    <path d="M24 30 L28 34 L36 26" stroke="#082821" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <text x="60" y="28" font-family="'Inter', sans-serif" font-size="14" font-weight="800" fill="#082821">100% Certified</text>
    <text x="60" y="44" font-family="'Inter', sans-serif" font-size="11" font-weight="600" fill="#5e736c">BNSP JWD Standard</text>
  </g>

  <!-- Central Illustrated People (Stylized Modern Vector Avatars) -->
  <g transform="translate(180, 140)">
    <!-- Person 1 (Lead / Manager) -->
    <ellipse cx="120" cy="270" rx="80" ry="100" fill="#1b4d41" />
    <!-- Collar & Suit -->
    <path d="M80 230 L120 280 L160 230" fill="#ffffff" />
    <path d="M115 250 L125 250 L125 320 L115 320 Z" fill="#7be147" />
    <!-- Head -->
    <circle cx="120" cy="160" r="42" fill="#fcd34d" />
    <!-- Glasses -->
    <rect x="98" y="150" width="18" height="12" rx="3" stroke="#082821" stroke-width="2.5" fill="none" />
    <rect x="124" y="150" width="18" height="12" rx="3" stroke="#082821" stroke-width="2.5" fill="none" />
    <line x1="116" y1="156" x2="124" y2="156" stroke="#082821" stroke-width="2" />
    <!-- Hair -->
    <path d="M78 160 C78 120 162 120 162 160 C162 140 145 130 120 130 C95 130 78 140 78 160 Z" fill="#082821" />

    <!-- Person 2 (Colleague with Laptop) -->
    <ellipse cx="230" cy="290" rx="70" ry="90" fill="#0e382f" stroke="#7be147" stroke-opacity="0.3" stroke-width="2" />
    <circle cx="230" cy="180" r="36" fill="#fde68a" />
    <!-- Hair female -->
    <path d="M194 185 C194 140 266 140 266 185 C266 220 256 225 256 200 C256 160 204 160 204 200 C204 225 194 220 194 185 Z" fill="#78350f" />
    <!-- Laptop in hand -->
    <rect x="120" y="270" width="110" height="70" rx="8" fill="#e2e8f0" transform="rotate(-10 120 270)" />
    <rect x="128" y="276" width="94" height="54" rx="4" fill="#082821" transform="rotate(-10 120 270)" />
    <circle cx="175" cy="303" r="6" fill="#7be147" />
  </g>

  <!-- Right Floating Metric Box (Biztop signature badge) -->
  <g transform="translate(360, 310)" filter="url(#shadow)">
    <rect width="190" height="90" rx="20" fill="#7be147" />
    <text x="24" y="42" font-family="'Inter', sans-serif" font-size="28" font-weight="900" fill="#082821">10K+</text>
    <text x="24" y="66" font-family="'Inter', sans-serif" font-size="12" font-weight="700" fill="#082821">Data Records Managed</text>
    <circle cx="150" cy="45" r="22" fill="#082821" />
    <path d="M142 45 L158 45 M152 39 L158 45 L152 51" stroke="#7be147" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
